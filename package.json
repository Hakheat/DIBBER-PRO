{
  "name": "dubber-pro-monorepo",
  "version": "1.0.0",
  "private": true,
  "workspaces": [
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"API,WEB\" -c \"blue.bold,green.bold\" \"npm run dev --workspace=@dubber/backend\" \"npm run dev --workspace=@dubber/frontend\"",
    "build": "npm run build --workspace=@dubber/backend && npm run build --workspace=@dubber/frontend",
    "lint": "eslint .",
    "test": "vitest run",
    "typecheck": "npx tsc -p backend/tsconfig.json --noEmit && npx tsc -p frontend/tsconfig.json --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^9.10.0",
    "concurrently": "^9.2.4",
    "electron": "^44.5.1",
    "electron-builder": "^26.15.3",
    "eslint": "^9.10.0",
    "fs-extra": "^11.4.1",
    "globals": "^15.9.0",
    "prettier": "^3.3.3",
    "tcp-port-used": "^1.0.3",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.5.0",
    "vitest": "^2.1.1",
    "wait-on": "^9.5.1"
  }
}
